---
- name: Determine primary repo server name from global_repo_servers
  set_fact:
    primary_repo_server: "{{ global_repo_servers | selectattr('primary', 'defined') | selectattr('primary') | map(attribute='name') | first }}"

- name: Check if current server is the primary repo server
  set_fact:
    is_primary_repo_server: "{{ primary_repo_server == inventory_hostname }}"

- name: Show result
  debug:
    msg: "This server ({{ inventory_hostname }}) is {{ 'the PRIMARY' if is_primary_repo_server else 'NOT the primary' }} repo server."
...
